  "sound_files": {
    "dir": "/sd/tones",
    "format": {
      "container": "wav",
      "audio_format": 1,
      "sample_rate": 48000,
      "channels": 1,
      "bits": 16
    },
    "max_upload_bytes": 16777216,
    "name_rule": "bare file name ending .wav (any case), 5-63 bytes UTF-8, no leading '.', none of / \\ : * ? \" < > | or control characters",
    "crc": "CRC-32/ISO-HDLC over the whole file (zlib crc32; check value of '123456789' = cbf43926), sent as hex",
    "list_pairs": {
      "card": "<total_bytes>/<free_bytes>",
      "alarm": "<name> of the alarm tone, empty = the built-in beep",
      "tone": "<size_bytes>/<duration_ms>/<state>/<name> -- one per .wav, name last (it may contain anything but '/')"
    },
    "tone_states": [
      "ok",
      "not-wav",
      "not-pcm",
      "rate",
      "channels",
      "bits",
      "no-data",
      "truncated",
      "unreadable"
    ],
    "blob_att_errors": {
      "0x80": {
        "name": "busy",
        "action": "retry the same write after ~50 ms"
      },
      "0x81": {
        "name": "bad-offset",
        "action": "not the expected offset, or past the size: send `storage put <name> <size> <crc>` again and continue from its `next`"
      },
      "0x82": {
        "name": "no-upload",
        "action": "no `storage put` is open (never opened, ended, aborted, or the clock rebooted): start again"
      },
      "0x83": {
        "name": "failed",
        "action": "the card refused a write: `storage put abort`, then start again"
      }
    }
  },
  "wifi": {
    "sntp_servers": [
      "time.cloudflare.com",
      "time.google.com",
      "pool.ntp.org"
