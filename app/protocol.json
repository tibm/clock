    "security": "LE Secure Connections, Just Works, bonded. Every characteristic requires an encrypted + bonded link.",
    "max_connections": 1,
    "preferred_mtu": 247
  },

  "advertising": {
    "service_uuid_in_adv": true,
    "local_name": "clock",
    "local_name_in": "scan_response",
    "manufacturer_data": {
      "company_id": 65535,
      "layout": "bytes 0-1 = company id 0xFFFF little-endian (FF FF), byte 2 = state",
      "state_bits": { "0": "pairing_window_open" }
    },
    "interval_ms": { "idle": 1000, "pairing": 100 }
  },

  "command_channel": {
    "request_format": "<id> <cli line>",
    "request_id_range": [0, 65535],
    "request_id_optional": true,
    "max_request_bytes": 256,
    "response_kinds": {
      "|": "one complete output line (human text, NOT stable -- display only)",
      "+": "fragment; the record continues in the next frame with the same id",
      "=": "key=value record (machine-readable, stable when a command documents it)",
      "$": "terminal status, exactly one per request, always last"
    },
    "statuses": ["ok", "bad-arg", "denied", "busy", "not-ready", "failed", "not-present"],
    "max_in_flight": 4,
    "cli_wait_before_busy_ms": 1500,
    "recommended_timeout_ms": 10000
  },

  "commands": [
    { "line": "sys ver",                              "status": "implemented", "unsafe": false, "use": "firmware identity, display" },
    { "line": "sys snap",                             "status": "implemented", "unsafe": false, "use": "the status record as text, display/debug" },
    { "line": "net ble pair off",                     "status": "implemented", "unsafe": false, "use": "close the pairing window" },
    { "line": "net ble unbond",                       "status": "implemented", "unsafe": false, "use": "forget every phone; drops this link. The user must also 'Forget This Device' in iOS Settings" },
    { "line": "net ble period <ms>",                  "status": "implemented", "unsafe": false, "args": { "ms": [100, 3600000] }, "use": "status notify cadence; global, not persisted (1000 after boot)" },
    { "line": "chrono time set <hh:mm[:ss]>",         "status": "implemented", "unsafe": false, "use": "set local wall time (no date in v1)" },
    { "line": "chrono steps <n>",                     "status": "implemented", "unsafe": false, "args": { "n": [1, 60] }, "use": "hand positions per minute: 1 = tick, 60 = sweep" },
    { "line": "ui knob bright <pct>",                 "status": "implemented", "unsafe": false, "args": { "pct": [0, 100] }, "use": "status LED brightness" },
    { "line": "audio vol <pct>",                      "status": "implemented", "unsafe": false, "args": { "pct": [0, 100] }, "use": "volume; values over the firmware ceiling (currently 25) answer $denied" },
    { "line": "audio tone [<hz>] [<ms>]",             "status": "implemented", "unsafe": false, "use": "test sound / find my clock" },
    { "line": "audio stop",                           "status": "implemented", "unsafe": false, "use": "stop a tone" },
    { "line": "unsafe on",                            "status": "implemented", "unsafe": false, "use": "unlock hardware-moving commands for 60 s (debug screen only)" },
    { "line": "motion home",                          "status": "implemented", "unsafe": true,  "use": "re-home the hands (debug)" },
    { "line": "sys reboot",                           "status": "implemented", "unsafe": true,  "use": "restart; the link drops without a $ record" },
    { "line": "chrono time epoch <unix_ms> <utc_offset_min>", "status": "planned", "unsafe": false, "use": "set date + time + current UTC offset from the phone" },
    { "line": "chrono alarm set <hh:mm>",             "status": "planned", "unsafe": false, "use": "alarm time (knob-only today)" },
    { "line": "chrono alarm arm <on|off>",            "status": "planned", "unsafe": false, "use": "arm / disarm the alarm (knob-only today)" }
  ],

