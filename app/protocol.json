  "history": {
    "dir": "/sd/log",
    "files": "one file per UTC day: /sd/log/<yyyy>/<mmdd>.bin = 32-byte header + 24-byte records, append-only. Only today's file grows; retention deletes whole files (oldest first)",
    "defaults": {
      "period_s": 300,
      "keep_days": 731,
      "cap_mb": 200
    },
    "header": {
      "size": 32,
      "fields": [
        {
          "off": 0,
          "type": "char[4]",
          "name": "magic",
          "value": "CLKL"
        },
        {
          "off": 4,
          "type": "u8",
          "name": "version",
          "value": 1
        },
        {
          "off": 5,
          "type": "u8",
          "name": "record_size",
          "value": 24
        },
        {
          "off": 6,
          "type": "u16",
          "name": "period_s",
          "note": "the period when the file was created; records carry their own time"
        },
        {
          "off": 8,
          "type": "u32",
          "name": "day",
          "note": "Unix seconds of 00:00 UTC of this file's day"
        },
        {
          "off": 12,
          "type": "u32",
          "name": "fw_id",
          "note": "as in the snapshot"
        },
        {
          "off": 16,
          "type": "u8[16]",
          "name": "reserved"
        }
      ]
    },
    "record": {
      "size": 24,
      "endianness": "little",
      "crc": "byte 23 = CRC-8 (poly 0x07, init 0x00, not reflected; CRC-8/SMBUS) of bytes 0-22. A record that fails it is skipped (a torn write after a power cut); the next record is still aligned",
      "kinds": {
        "1": "sample",
        "2": "event"
      },
      "sample": [
        {
          "off": 0,
          "type": "u8",
          "name": "kind",
          "value": 1
        },
        {
          "off": 1,
          "type": "u8",
          "name": "n",
          "note": "readings averaged into this record (one every 10 s)"
        },
        {
          "off": 2,
          "type": "u32",
          "name": "t",
          "unit": "s",
          "note": "Unix seconds UTC, the START of the period; always a multiple of the period"
        },
        {
          "off": 6,
          "type": "i16",
          "name": "temp",
          "scale": 0.01,
          "unit": "°C",
          "valid_if": "env_ok"
        },
        {
          "off": 8,
          "type": "u16",
          "name": "rh",
          "scale": 0.01,
          "unit": "%",
          "valid_if": "env_ok"
        },
        {
          "off": 10,
          "type": "u16",
          "name": "press",
          "scale": 0.1,
          "unit": "hPa",
          "valid_if": "env_ok"
        },
        {
          "off": 12,
          "type": "u16",
          "name": "gas",
          "encoding": "log_gas",
          "unit": "Ω",
          "valid_if": "env_ok",
          "note": "geometric mean over the period"
        },
        {
          "off": 14,
          "type": "u16",
          "name": "lux",
          "encoding": "log_lux16",
          "unit": "lx",
          "valid_if": "als_ok",
          "note": "mean over the period"
        },
        {
          "off": 16,
          "type": "u16",
          "name": "vbat",
          "unit": "mV",
          "valid_if": "power_ok"
        },
        {
          "off": 18,
          "type": "u8",
          "name": "soc",
          "unit": "%",
          "valid_if": "power_ok",
          "sentinel": {
            "255": "unknown"
          }
        },
        {
          "off": 19,
          "type": "i8",
          "name": "rssi",
          "unit": "dBm",
          "valid_if": "wifi_online"
        },
        {
          "off": 20,
          "type": "u16",
          "name": "flags",
          "bitfield": "sample_flags"
        },
        {
          "off": 22,
          "type": "u8",
          "name": "lux_max",
          "encoding": "log_lux8",
          "unit": "lx",
          "valid_if": "als_ok",
          "note": "peak in the period, coarse (~12 %)"
        },
        {
          "off": 23,
          "type": "u8",
          "name": "crc8"
        }
      ],
      "event": [
        {
          "off": 0,
          "type": "u8",
          "name": "kind",
          "value": 2
        },
        {
          "off": 1,
          "type": "u8",
          "name": "code",
          "enum": "event_code"
        },
        {
          "off": 2,
          "type": "u32",
          "name": "t",
          "unit": "s",
          "note": "Unix seconds UTC, when it happened"
        },
        {
          "off": 6,
          "type": "u8[16]",
          "name": "args",
          "note": "per code, see event_args"
        },
        {
          "off": 22,
          "type": "u8",
          "name": "reserved"
        },
        {
          "off": 23,
          "type": "u8",
          "name": "crc8"
        }
      ]
    },
    "encodings": {
      "log_gas": "ohms = 10^(v / 8192)",
      "log_lux16": "lux = 10^(v / 12000) - 1",
      "log_lux8": "lux = 10^(v / 50) - 1"
    },
