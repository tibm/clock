{
  "$comment": "Machine-readable half of app/PROTOCOL.md -- the clock <-> app BLE contract. PROTOCOL.md is normative for behaviour; this file is normative for numbers (UUIDs, offsets, enums, golden vector). The firmware test suite (firmware/test/host/test_net.cpp) asserts the golden vector against the shipping encoder.",
  "protocol_version": 1,
  "snapshot_schema": 1,
  "gatt": {
    "service_uuid": "7a3e0001-5c1d-4b8e-9f3a-2c6d1e0b9a41",
    "characteristics": {
      "cmd": {
        "uuid": "7a3e0002-5c1d-4b8e-9f3a-2c6d1e0b9a41",
        "properties": [
          "write"
        ],
        "max_len": 256,
        "encoding": "utf8"
      },
      "rsp": {
        "uuid": "7a3e0003-5c1d-4b8e-9f3a-2c6d1e0b9a41",
        "properties": [
          "notify"
        ],
        "encoding": "utf8"
      },
      "status": {
        "uuid": "7a3e0004-5c1d-4b8e-9f3a-2c6d1e0b9a41",
        "properties": [
          "read",
          "notify"
        ],
        "encoding": "binary",
        "len": 132
      },
      "info": {
        "uuid": "7a3e0005-5c1d-4b8e-9f3a-2c6d1e0b9a41",
        "properties": [
          "read"
        ],
        "encoding": "utf8"
      },
      "blob": {
        "uuid": "7a3e0006-5c1d-4b8e-9f3a-2c6d1e0b9a41",
        "properties": [
          "write"
        ],
        "max_len": 512,
        "encoding": "binary",
        "layout": "bytes 0-3 = offset, uint32 little-endian; bytes 4.. = file data. Write WITH response, one at a time"
      },
      "bulk": {
        "uuid": "7a3e0007-5c1d-4b8e-9f3a-2c6d1e0b9a41",
        "properties": [
          "notify"
        ],
        "encoding": "binary",
        "layout": "bytes 0-3 = offset into the file being sent, uint32 little-endian; bytes 4.. = file data. At most MTU-3 bytes per notification"
      }
    },
    "security": "LE Secure Connections, Just Works, bonded. Every characteristic requires an encrypted + bonded link.",
    "max_connections": 1,
    "preferred_mtu": 247
  },
  "advertising": {
    "service_uuid_in_adv": true,
    "local_name": "clock",
    "local_name_in": "scan_response",
    "manufacturer_data": {
      "company_id": 65535,
      "layout": "bytes 0-1 = company id 0xFFFF little-endian (FF FF), byte 2 = state",
      "state_bits": {
        "0": "pairing_window_open"
      }
    },
    "interval_ms": {
      "idle": 1000,
      "pairing": 100
    }
  },
  "command_channel": {
    "request_format": "<id> <cli line>",
    "request_id_range": [
      0,
      65535
    ],
    "request_id_optional": true,
    "max_request_bytes": 256,
    "response_kinds": {
      "|": "one complete output line (human text, NOT stable -- display only)",
      "+": "fragment; the record continues in the next frame with the same id",
      "=": "key=value record (machine-readable, stable when a command documents it)",
      "$": "terminal status, exactly one per request, always last"
    },
    "statuses": [
      "ok",
      "bad-arg",
      "denied",
      "busy",
      "not-ready",
      "failed",
      "not-present"
    ],
    "max_in_flight": 4,
    "cli_wait_before_busy_ms": 1500,
    "recommended_timeout_ms": 10000
  },
  "commands": [
    {
      "line": "sys ver",
      "status": "implemented",
      "unsafe": false,
      "use": "firmware identity, display"
    },
    {
      "line": "sys snap",
      "status": "implemented",
      "unsafe": false,
      "use": "the status record as text, display/debug"
    },
    {
      "line": "net ble pair off",
      "status": "implemented",
      "unsafe": false,
      "use": "close the pairing window"
    },
    {
      "line": "net ble unbond",
      "status": "implemented",
      "unsafe": false,
      "use": "forget every phone; drops this link. The user must also 'Forget This Device' in iOS Settings"
    },
    {
      "line": "net ble period <ms>",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "ms": [
          100,
          3600000
        ]
      },
      "use": "status notify cadence; global, not persisted (1000 after boot)"
    },
    {
      "line": "net wifi",
      "status": "implemented",
      "unsafe": false,
      "use": "Wi-Fi state as `=` pairs: state= (wifi_state name), ssid= (stored network, empty = none), err= (wifi_err name), rssi=, ip=, synced= (0/1)"
    },
    {
      "line": "net wifi join <ssid> [<psk>]",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "ssid": "1-32 bytes; send as hex:<utf8 bytes hex>",
        "psk": "8-63 characters, or 64 hex digits; omit for an open network; send as hex:<utf8 bytes hex>"
      },
      "use": "store the network (replaces any other) and join it. Answers ok at once; watch wifi_state / wifi_err in the snapshot. Persisted; retried with backoff for ever"
    },
    {
      "line": "net wifi forget",
      "status": "implemented",
      "unsafe": false,
      "use": "forget the stored network and disconnect; wifi_state -> idle"
    },
    {
      "line": "net wifi scan",
      "status": "implemented",
      "unsafe": false,
      "use": "networks in range, strongest first, as `=ap=<rssi>/<open|secured>/<channel>/<ssid>` (SSID last; split on the first three '/'). Takes ~3 s. busy while joining"
    },
    {
      "line": "net sntp",
      "status": "implemented",
      "unsafe": false,
      "use": "time servers, last sync, next (display only)"
    },
    {
      "line": "net sntp sync",
      "status": "implemented",
      "unsafe": false,
      "use": "ask the time servers now; not-ready unless wifi_state is online"
    },
    {
      "line": "chrono time set <hh:mm[:ss]>",
      "status": "implemented",
      "unsafe": false,
      "use": "set the LOCAL time of day; keeps the date if the clock has one"
    },
    {
      "line": "chrono time epoch <unix_ms> [<utc_offset_min>]",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "unix_ms": ">= 100000000000 (milliseconds, UTC)",
        "utc_offset_min": [
          -720,
          840
        ]
      },
      "use": "set date + time from the phone. With an offset: the offset in force now -- if the clock's zone agrees it is kept, otherwise the zone becomes that fixed offset. Offset omitted = the clock's zone decides. A value that looks like seconds answers bad-arg"
    },
    {
      "line": "chrono tz [<utc_offset_min> | <posix_tz> [<name>]]",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "utc_offset_min": [
          -720,
          840
        ],
        "posix_tz": "POSIX TZ rule, e.g. PST8PDT,M3.2.0,M11.1.0 (see PROTOCOL.md 'Keeping time')",
        "name": "IANA label, e.g. America/Los_Angeles; display only, < 40 bytes, no spaces"
      },
      "use": "read / set the zone (same instant, the hands move). A POSIX rule lets the clock change DST by itself; a bare offset is a fixed zone. Default when never set: San Francisco. NVS-persisted. Bare `chrono tz` answers `=posix=`, `=name=`, `=offset=`"
    },
    {
      "line": "chrono alarm",
      "status": "implemented",
      "unsafe": false,
      "use": "show the alarm (display only; state is in the snapshot)"
    },
    {
      "line": "chrono alarm set <hh:mm>",
      "status": "implemented",
      "unsafe": false,
      "use": "alarm time, local, 24 h. NVS-persisted. Answers after the clock has taken it"
    },
    {
      "line": "chrono alarm arm <on|off>",
      "status": "implemented",
      "unsafe": false,
      "use": "arm / disarm. NVS-persisted. When armed the clock rings at the set local minute (ui_mode -> ringing)"
    },
    {
      "line": "chrono alarm tone [<name>|none]",
      "status": "implemented",
      "unsafe": false,
      "use": "which /sd/tones WAV rings (bare file name; none = the built-in beep). Checked on the card first: bad-arg if it is not 48 kHz mono 16-bit, not-present with no card. NVS-persisted"
    },
    {
      "line": "chrono alarm fire",
      "status": "implemented",
      "unsafe": false,
      "use": "ring now (a test of the alarm sound); ui_mode -> ringing"
    },
    {
      "line": "chrono alarm snooze",
      "status": "implemented",
      "unsafe": false,
      "use": "snooze a ringing alarm (not-ready otherwise); ui_mode -> snoozed"
    },
    {
      "line": "chrono alarm dismiss",
      "status": "implemented",
      "unsafe": false,
      "use": "stop a ringing or snoozed alarm; it stays armed for tomorrow (not-ready otherwise)"
    },
    {
      "line": "chrono steps <n>",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "n": [
          1,
          60
        ]
      },
      "use": "hand positions per minute: 1 = tick, 60 = sweep"
    },
    {
      "line": "ui knob bright <pct>",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "pct": [
          0,
          100
        ]
      },
      "use": "status LED brightness"
    },
    {
      "line": "audio vol <pct>",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "pct": [
          0,
          100
        ]
      },
      "use": "volume; values over the firmware ceiling (currently 25) answer $denied"
    },
    {
      "line": "audio tone [<hz>] [<ms>]",
      "status": "implemented",
      "unsafe": false,
      "use": "test sound / find my clock"
    },
    {
      "line": "audio stop",
      "status": "implemented",
      "unsafe": false,
      "use": "stop a tone or a playing file (not a ringing alarm's mode -- use chrono alarm dismiss)"
    },
    {
      "line": "audio play <name> [loop]",
      "status": "implemented",
      "unsafe": false,
      "use": "play a /sd/tones WAV (48 kHz mono 16-bit) once, or looped until audio stop; e.g. to preview an alarm tone"
    },
    {
      "line": "storage tones",
      "status": "implemented",
      "unsafe": false,
      "use": "list /sd/tones as `=` pairs: card=, alarm=, one tone= per .wav (sound_files.list_pairs). not-present with no card"
    },
    {
      "line": "storage rm <name>",
      "status": "implemented",
      "unsafe": false,
      "use": "delete a file from /sd/tones. If it was the alarm tone the alarm falls back to the beep (the `|` line says so). failed = no such file"
    },
    {
      "line": "storage put <name> <size> <crc32_hex>",
      "status": "implemented",
      "unsafe": false,
      "use": "open an upload -- or resume the open one when name/size/crc all match. Answers `=next=<offset>` and `=size=`. Then send the bytes to the blob characteristic"
    },
    {
      "line": "storage put",
      "status": "implemented",
      "unsafe": false,
      "use": "the open upload: `=name=`, `=next=`, `=size=`; not-ready when none"
    },
    {
      "line": "storage put end",
      "status": "implemented",
      "unsafe": false,
      "use": "finish: checks length, CRC and the WAV header, then the file appears in /sd/tones (replacing one of the same name). not-ready + `=next=` = bytes missing; bad-arg = CRC mismatch or not a usable WAV (upload discarded)"
    },
    {
      "line": "storage put abort",
      "status": "implemented",
      "unsafe": false,
      "use": "discard the open upload"
    },
    {
      "line": "log status",
      "status": "implemented",
      "unsafe": false,
      "use": "history log settings and state as `=` pairs: on (0/1), period (s), keep (days), cap (MB), projected (bytes on the card at these settings), used (bytes on the card), days (day files), ram (records not yet on the card)"
    },
    {
      "line": "log period <s>",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "s": [
          10,
          3600
        ]
      },
      "use": "one record per this many seconds (default 300). denied when period x keep would exceed the cap; the `|` line gives the numbers. NVS-persisted"
    },
    {
      "line": "log keep <days>",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "days": [
          1,
          3650
        ]
      },
      "use": "days kept on the card (default 731); older day files are deleted. denied over the cap. NVS-persisted"
    },
    {
      "line": "log cap <MB>",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "MB": [
          10,
          2000
        ]
      },
      "use": "most the log may take on the card, cluster-rounded (default 200); oldest days are deleted past it. denied if the current period x keep already exceeds it. NVS-persisted"
    },
    {
      "line": "log enable <on|off>",
      "status": "implemented",
      "unsafe": false,
      "use": "record or stop recording; files stay"
    },
    {
      "line": "log days",
      "status": "implemented",
      "unsafe": false,
      "use": "every day file on the card, oldest first, as `=day=<yyyymmdd>/<bytes>`. Writes the RAM records to the card first, so today is complete. not-present with no card"
    },
    {
      "line": "log fetch <yyyymmdd> [<offset>]",
      "status": "implemented",
      "unsafe": false,
      "args": {
        "yyyymmdd": "a UTC date from `log days`",
        "offset": "byte offset to start from (default 0)"
      },
      "use": "send [offset, size) of that day file on the `bulk` characteristic. Answers `=day=` `=from=` `=size=` `=crc=` (CRC-32/zlib of exactly the bytes sent, 8 hex) then $ok; the data follows on `bulk`. failed = no such day; bad-arg = offset past the end"
    },
    {
      "line": "log fetch stop",
      "status": "implemented",
      "unsafe": false,
      "use": "abandon a download in progress"
    },
    {
      "line": "log flush",
      "status": "implemented",
      "unsafe": false,
      "use": "write the RAM records to the card now"
    },
    {
      "line": "unsafe on",
      "status": "implemented",
      "unsafe": false,
      "use": "unlock hardware-moving commands for 60 s (debug screen only)"
    },
    {
      "line": "motion home",
      "status": "implemented",
      "unsafe": true,
      "use": "re-home the hands (debug)"
    },
    {
      "line": "sys reboot",
      "status": "implemented",
      "unsafe": true,
      "use": "restart; the link drops without a $ record"
    }
  ],
