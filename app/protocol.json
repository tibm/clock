    "service_uuid": "7a3e0001-5c1d-4b8e-9f3a-2c6d1e0b9a41",
    "characteristics": {
      "cmd":    { "uuid": "7a3e0002-5c1d-4b8e-9f3a-2c6d1e0b9a41", "properties": ["write"],          "max_len": 256, "encoding": "utf8" },
      "rsp":    { "uuid": "7a3e0003-5c1d-4b8e-9f3a-2c6d1e0b9a41", "properties": ["notify"],         "encoding": "utf8" },
      "status": { "uuid": "7a3e0004-5c1d-4b8e-9f3a-2c6d1e0b9a41", "properties": ["read", "notify"], "encoding": "binary", "len": 132 },
